  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 420
  },
  "scope_extensions": [
    {
      "origin": "https://georgevillalobos.github.io"
    }
  ]
}